{
  "name": "studytracker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "typecheck": "tsc --noEmit",
    "db:verify:local": "bash supabase/tests/run-local-verification.sh",
    "db:check": "node --env-file-if-exists=.env.local scripts/check-db.mjs",
    "role": "node --env-file-if-exists=.env.local scripts/set-role.mjs",
    "seed": "node --env-file-if-exists=.env.local scripts/seed-demo.mjs",
    "db:verify:live": "node --env-file-if-exists=.env.local scripts/verify-live-rls.mjs",
    "smoke:ui": "node --env-file-if-exists=.env.local scripts/smoke-ui.mjs",
    "test:planner": "node --import ./scripts/alias-hook.mjs --test scripts/test-planner.mjs",
    "password": "node --env-file-if-exists=.env.local scripts/set-password.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.116.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.3.2",
    "geist": "^1.7.2",
    "lucide-react": "^1.47.0",
    "motion": "^13.4.0",
    "next": "16.3.5",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "shadcn": "^4.21.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
