# ---------------------------------------------------------------------------
# StudyFlow environment
# Copy to .env.local and fill in. .env.local is gitignored.
# ---------------------------------------------------------------------------

# --- Supabase (REQUIRED from Phase 1) --------------------------------------
# Supabase dashboard -> Project Settings -> API.
#
# The anon key is meant to be public: it identifies the project, not the user,
# and every query it makes is still bound by Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Bypasses RLS entirely -- for the seed script and admin tasks.
# Never prefix it with NEXT_PUBLIC_, never import it into a Client Component.
# Not used yet; Phase 2 needs it for seeding.
SUPABASE_SERVICE_ROLE_KEY=

# --- Timetable extraction (Phase 8) ---------------------------------------
# mock      -> returns a fixture; no network, no key, no spend. Default.
# anthropic -> real vision/PDF extraction.
TIMETABLE_EXTRACTOR=mock

# Only read when TIMETABLE_EXTRACTOR=anthropic. Server-only; referenced
# exclusively from src/lib/extraction/anthropic.ts.
ANTHROPIC_API_KEY=
