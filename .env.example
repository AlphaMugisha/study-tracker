# ---------------------------------------------------------------------------
# StudyFlow environment
# Copy to .env.local and fill in. .env.local is gitignored.
#
# Phase 0 needs NONE of these. The app boots, renders and is reviewable with
# this file absent. Each variable is introduced by the phase noted beside it.
# ---------------------------------------------------------------------------

# --- Supabase (Phase 1) ----------------------------------------------------
# Project Settings -> API in the Supabase dashboard.
# The anon key is safe in the browser: every query is still bound by RLS.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Bypasses RLS entirely -- used by the seed script and admin
# tasks. Never prefix this with NEXT_PUBLIC_ and never import it into a
# Client Component.
SUPABASE_SERVICE_ROLE_KEY=

# --- Timetable extraction (Phase 8) ---------------------------------------
# mock      -> returns a fixture; no network, no key, no spend. Default.
# anthropic -> real vision/PDF extraction.
TIMETABLE_EXTRACTOR=mock

# Only read when TIMETABLE_EXTRACTOR=anthropic. Server-only; it is referenced
# exclusively from src/lib/extraction/anthropic.ts.
ANTHROPIC_API_KEY=
