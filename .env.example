# ---------------------------------------------------------------------------
# StudyFlow environment
# Copy to .env.local and fill in. .env.local is gitignored.
# ---------------------------------------------------------------------------

# --- Supabase (REQUIRED from Phase 1) --------------------------------------
# Supabase dashboard -> Project Settings -> API Keys.
#
# Supabase renamed its keys; the new ones drop into the old variable names:
#     sb_publishable_...  ->  NEXT_PUBLIC_SUPABASE_ANON_KEY
#     sb_secret_...       ->  SUPABASE_SERVICE_ROLE_KEY
#
# The publishable/anon key is meant to be public: it identifies the project,
# not the user, and every query it makes is still bound by Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Bypasses RLS entirely -- for the seed script and admin tasks.
# Never prefix it with NEXT_PUBLIC_, never import it into a Client Component.
# Not used yet; Phase 2 needs it for seeding.
SUPABASE_SERVICE_ROLE_KEY=

# --- Reading a timetable from a photo --------------------------------------
# mock      -> returns a fixed week. No network, no key, no spend. Default,
#              because the upload flow and its review screen must be runnable
#              on a fresh clone. The review screen says when it is in use.
# anthropic -> actually reads the uploaded image.
TIMETABLE_EXTRACTOR=mock

# Only read when TIMETABLE_EXTRACTOR=anthropic. Server-only, and referenced
# exclusively from src/lib/timetable/extract.ts -- never import that module
# from a client component: the shared constants live in
# src/lib/timetable/import-constants.ts for exactly that reason.
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
