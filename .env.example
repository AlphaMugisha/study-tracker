# ---------------------------------------------------------------------------
# StudyFlow environment
# Copy to .env.local and fill in. .env.local is gitignored.
# ---------------------------------------------------------------------------

# --- Supabase (REQUIRED from Phase 1) --------------------------------------
# Supabase dashboard -> Project Settings -> API Keys.
#
# Supabase renamed its keys; the new ones drop into the old variable names:
#     sb_publishable_...  ->  NEXT_PUBLIC_SUPABASE_ANON_KEY
#     sb_secret_...       ->  SUPABASE_SERVICE_ROLE_KEY
#
# The publishable/anon key is meant to be public: it identifies the project,
# not the user, and every query it makes is still bound by Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Bypasses RLS entirely -- for the seed script and admin tasks.
# Never prefix it with NEXT_PUBLIC_, never import it into a Client Component.
# Not used yet; Phase 2 needs it for seeding.
SUPABASE_SERVICE_ROLE_KEY=

# --- Reading a timetable from a photo --------------------------------------
# mock      -> returns a fixed week. No network, no key, no spend. Default,
#              because the upload flow and its review screen must be runnable
#              on a fresh clone. The review screen says when it is in use.
# anthropic -> actually reads the uploaded image. Billed per call.
# google    -> also reads it, on Gemini's free tier. No card, lower rate
#              limits, and Google trains on what you send -- which for a photo
#              carrying a child's name and her teachers' names is a decision
#              worth making on purpose rather than by default.
TIMETABLE_EXTRACTOR=mock

# Only read when TIMETABLE_EXTRACTOR=anthropic. Server-only, and referenced
# exclusively from src/lib/timetable/extract.ts -- never import that module
# from a client component: the shared constants live in
# src/lib/timetable/import-constants.ts for exactly that reason.
# Get one at https://console.anthropic.com/settings/keys
# A key on an account with no credit authenticates fine and then fails every
# request -- the balance belongs to the account, not to the key, so a fresh
# key changes nothing.
ANTHROPIC_API_KEY=

# Only read when TIMETABLE_EXTRACTOR=google. Same server-only rule as above.
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional. Pins one Gemini model instead of trying the built-in list in
# order. The list exists because the free tier returns 503 on whichever model
# is busy -- including, often, the flagship -- and one hard-coded name means
# the upload screen is down whenever that model is.
GEMINI_MODEL=
